    "@upstash/redis": "1.40.0",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
