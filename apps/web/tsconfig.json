{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }, "types": ["vite/client"]
  },
  "include": ["src", "../../packages/shared/src"]
}
