{
  "name": "resona-desktop",
  "productName": "Resona",
  "version": "0.4.0",
  "description": "Resona for desktop: music without ads, with synced lyrics, lossless FLAC and downloads.",
  "author": "Praveen Kumar",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "ffmpeg:win": "node scripts/fetch-ffmpeg.mjs win32 x64",
    "start": "npm --prefix ../.. run build && npm run bundle && electron .",
    "dist:win": "npm --prefix ../.. run build && npm run bundle && npm run ffmpeg:win && electron-builder --win nsis --x64 --publish never",
    "ffmpeg:mac": "node scripts/fetch-ffmpeg.mjs darwin arm64",
    "dist:mac": "npm --prefix ../.. run build && npm run bundle && npm run ffmpeg:mac && electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "electron": "45.2.2",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "app.echomusic.web",
    "productName": "Resona",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "vendor/win32-x64",
          "to": "bin",
          "filter": [
            "ffmpeg.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Resona",
      "artifactName": "Resona-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "vendor/darwin-arm64",
          "to": "bin",
          "filter": [
            "ffmpeg"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Resona uses the microphone for voice search.",
        "NSLocalNetworkUsageDescription": "Resona looks for Chromecast, Google TV and Nest devices on your network so you can cast music to them.",
        "NSBonjourServices": [
          "_googlecast._tcp"
        ]
      }
    },
    "dmg": {
      "artifactName": "Resona-${version}-${arch}.dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alwaysspraveen",
        "repo": "resona",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.12",
    "multicast-dns": "^7.2.5"
  }
}
