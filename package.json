{
  "name": "echo-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "concurrently -n server,web -c red,blue \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "npm test -w apps/web",
    "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/web",
    "smoke": "npm run smoke -w apps/server",
    "start": "npm run start -w apps/server"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-transform-unicode-property-regex": "^7.27.1",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
